<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="my_rgl_world_osci">
    <!-- This world is only for the known-obstacle oscillation case.  Spawn the
         existing PX4 x500 + RGL model into it with the normal simulation launch. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.22 0.24 0.22 1</ambient>
            <diffuse>0.30 0.32 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- YAML obstacle 1: static center=[20,0,4], axes=[2,2,4]. -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>20 0 4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><ellipsoid><radii>2 2 4</radii></ellipsoid></geometry>
        </collision>
        <visual name="visual">
          <geometry><ellipsoid><radii>2 2 4</radii></ellipsoid></geometry>
          <material><diffuse>0.55 0.55 0.60 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- YAML obstacle 2: y(t)=-5+4*sin(0.25*t), radius=3. -->
    <model name="obstacle_2">
      <static>false</static>
      <pose>35 -5 6 0 0 0</pose>
      <link name="link">
        <kinematic>true</kinematic>
        <gravity>false</gravity>
        <collision name="collision">
          <geometry><sphere><radius>3</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>3</radius></sphere></geometry>
          <material><diffuse>0.90 0.20 0.15 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="libifds_obstacle_oscillator.so" name="ifds::sim::ObstacleOscillator">
        <amplitude_y>4.0</amplitude_y>
        <angular_speed>0.25</angular_speed>
        <phase>0.0</phase>
      </plugin>
    </model>

    <!-- YAML obstacle 3: y(t)=5+5*sin(0.20*t+pi/2), axes=[3,2,4]. -->
    <model name="obstacle_3">
      <static>false</static>
      <pose>50 5 7 0 0 0</pose>
      <link name="link">
        <kinematic>true</kinematic>
        <gravity>false</gravity>
        <collision name="collision">
          <geometry><ellipsoid><radii>3 2 4</radii></ellipsoid></geometry>
        </collision>
        <visual name="visual">
          <geometry><ellipsoid><radii>3 2 4</radii></ellipsoid></geometry>
          <material><diffuse>0.15 0.30 0.90 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="libifds_obstacle_oscillator.so" name="ifds::sim::ObstacleOscillator">
        <amplitude_y>5.0</amplitude_y>
        <angular_speed>0.20</angular_speed>
        <phase>1.57079632679</phase>
      </plugin>
    </model>

    <!-- YAML obstacle 4: static center=[65,0,6], axes=[2.5,2.5,5]. -->
    <model name="obstacle_4">
      <static>true</static>
      <pose>65 0 6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><ellipsoid><radii>2.5 2.5 5</radii></ellipsoid></geometry>
        </collision>
        <visual name="visual">
          <geometry><ellipsoid><radii>2.5 2.5 5</radii></ellipsoid></geometry>
          <material><diffuse>0.25 0.75 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
